# Backend Configuration
MAX_FILE_SIZE_MB=500
MAX_DURATION_MINUTES=30
WHISPER_MODEL_SIZE=base
OUTPUT_TTL_HOURS=24
MAX_CONCURRENT_JOBS=2
FRONTEND_URL=http://localhost:3000
